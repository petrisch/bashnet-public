    {
      "id": "scr_test",
      "label": "test",
      "type": "scripting",
      "description": "Evaluates expressions and returns a success or failure exit status.",
      "category": "logic",
      "tags": [
        "condition",
        "comparison",
        "status"
      ],
      "examples": [
        {
          "command": "test 1 -eq 1 && echo 'equal'",
          "expected_output": "equal",
          "explanation": "The condition is true, so the echo command runs."
        },
        {
          "command": "[ 1 -eq 1 ] && echo 'equal'",
          "expected_output": "equal",
          "explanation": "Alternative syntax using brackets."
        }
      ]
    },
    {
      "id": "scr_esac",
      "label": "esac",
      "type": "scripting",
      "description": "Marks the end of a case statement.",
      "category": "control structure",
      "tags": [
        "case",
        "block",
        "end"
      ],
      "examples": [
        {
          "command": "case $x in 1) echo one;; *) echo other;; esac",
          "expected_output": "one",
          "explanation": "Ends the case block."
