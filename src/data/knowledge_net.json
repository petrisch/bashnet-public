{
  "nodes": [
    {
      "id": "cmd_ls",
      "label": "ls",
      "type": "command",
      "description": "Lists directory contents and displays file and directory metadata depending on options.",
      "category": "file management",
      "tags": [
        "filesystem",
        "listing",
        "navigation",
        "metadata"
      ],
      "examples": [
        {
          "command": "ls",
          "expected_output": "file1.txt  file2.txt  dir1/",
          "explanation": "Displays a basic list of visible files and folders in the current directory."
        },
        {
          "command": "ls -l",
          "expected_output": "-rw-r--r-- 1 user user 1234 Jan 1 12:00 file1.txt",
          "explanation": "Shows file permissions, owner, group, size and last modification time in long list format."
        }
      ],
      "links": [
        "https://man7.org/linux/man-pages/man1/ls.1.html"
      ]
    },
    {
