    {
      "id": "scr_op_eq",
      "label": "-eq",
      "type": "scripting",
      "category": "comparison operator",
      "description": "Numeric equality check. Returns true if the two numbers are equal. Only valid within test expressions like [ ... ] or test.",
      "tags": [
        "comparison",
        "numeric",
        "equality"
      ],
      "examples": [
        {
          "command": "[ 5 -eq 5 ] && echo 'equal'",
          "expected_output": "equal",
          "explanation": "The condition is true because both numbers are equal."
        }
      ]
    },
    {
      "id": "scr_op_ne",
      "label": "-ne",
      "type": "scripting",
      "category": "comparison operator",
      "description": "Numeric inequality check. Returns true if the numbers are not equal. Only valid within test expressions.",
      "tags": [
