    {
      "id": "scr_if",
      "label": "if",
      "type": "scripting",
      "description": "Evaluates a condition and executes a block of code if the condition is true.",
      "category": "control structure",
      "tags": [
        "condition",
        "branch",
        "logic"
      ],
      "examples": [
        {
          "command": "if [ $x -eq 1 ]; then echo 'Equal'; fi",
          "expected_output": "Equal",
          "explanation": "Executes the code block because x equals 1."
        },
        {
          "command": "if [ $x -eq 2 ]; then echo 'Yes'; else echo 'No'; fi",
          "expected_output": "No",
          "explanation": "The else block runs because the condition is false."
        }
      ],
      "links": [
        "https://www.gnu.org/software/bash/manual/bash.html#Conditional-Constructs"
      ]
    },
    {
      "id": "scr_for",
      "label": "for",
      "type": "scripting",
      "description": "Iterates over a list or sequence of values and runs the code block for each item.",
      "category": "loop",
      "tags": [
        "iteration",
        "loop",
        "range"
      ],
      "examples": [
        {
          "command": "for i in 1 2 3; do echo $i; done",
          "expected_output": "1\n2\n3",
          "explanation": "Loops over a list of numbers and echoes each one."
        },
        {
          "command": "for file in *.txt; do echo $file; done",
          "expected_output": "file1.txt\nfile2.txt",
          "explanation": "Iterates over all .txt files in the directory."
        },
        {
          "command": "for ((i=0; i<3; i++)); do echo $i; done",
          "expected_output": "0\n1\n2",
          "explanation": "C-style loop using numeric counter."
        }
      ],
      "links": [
        "https://www.gnu.org/software/bash/manual/html_node/Looping-Constructs.html"
      ]
    },
    {
      "id": "scr_while",
      "label": "while",
      "type": "scripting",
      "description": "Executes a block of code repeatedly as long as the condition is true.",
      "category": "loop",
      "tags": [
        "condition",
        "loop",
        "control"
      ],
      "examples": [
        {
          "command": "x=0; while [ $x -lt 3 ]; do echo $x; x=$((x+1)); done",
          "expected_output": "0\n1\n2",
          "explanation": "Increments x until the condition is false."
        }
      ],
      "links": [
        "https://www.gnu.org/software/bash/manual/html_node/Looping-Constructs.html"
      ]
    },
    {
      "id": "scr_variable",
      "label": "Variable Assignment",
      "type": "scripting",
      "description": "Stores a value in a shell variable for reuse.",
      "category": "variable",
      "tags": [
        "assignment",
        "value",
        "shell-variable"
      ],
      "examples": [
        {
          "command": "name='Alice'",
          "expected_output": "",
          "explanation": "Assigns the string 'Alice' to the variable 'name'."
        },
        {
          "command": "count=42",
          "expected_output": "",
          "explanation": "Assigns the number 42 to the variable 'count'."
        }
      ],
      "links": [
        "https://www.gnu.org/software/bash/manual/html_node/Shell-Variables.html"
      ]
    },
    {
      "id": "scr_redirection",
      "label": "Redirection",
      "type": "scripting",
      "description": "Redirects standard output or error to a file or another stream.",
      "category": "io",
      "tags": [
        "stdout",
        "stderr",
        "file",
        "append"
      ],
      "examples": [
        {
          "command": "echo 'Hello' > output.txt",
          "expected_output": "",
          "explanation": "Overwrites output.txt with 'Hello'."
        },
        {
          "command": "echo 'Error' >> log.txt",
          "expected_output": "",
          "explanation": "Appends 'Error' to log.txt."
        },
        {
          "command": "ls nonexisting 2> error.txt",
          "expected_output": "",
          "explanation": "Redirects stderr to error.txt."
        }
      ],
      "links": [
        "https://www.gnu.org/software/bash/manual/html_node/Redirections.html"
      ]
    },
    {
      "id": "scr_then",
      "label": "then",
      "type": "scripting",
      "description": "Marks the beginning of a code block that should execute if a condition is true.",
      "category": "control structure",
      "tags": [
        "conditional",
        "branch",
        "logic"
      ],
      "examples": [
        {
          "command": "if [ $x -eq 1 ]; then echo 'x is 1'; fi",
          "expected_output": "x is 1",
          "explanation": "The code after 'then' executes because the condition is true."
        }
      ]
    },
    {
      "id": "scr_else",
      "label": "else",
      "type": "scripting",
      "description": "Defines the code block to execute when the if-condition is false.",
      "category": "control structure",
      "tags": [
        "conditional",
        "fallback",
        "branch"
      ],
      "examples": [
        {
          "command": "if [ $x -eq 0 ]; then echo 'Zero'; else echo 'Not Zero'; fi",
          "expected_output": "Not Zero",
          "explanation": "The else block executes because the condition is false."
        }
      ]
    },
    {
      "id": "scr_do",
      "label": "do",
      "type": "scripting",
      "description": "Marks the beginning of a loop body for for-, while-, or until-loops.",
      "category": "loop",
      "tags": [
        "loop",
        "body",
        "structure"
      ],
      "examples": [
        {
          "command": "for i in 1 2 3; do echo $i; done",
          "expected_output": "1\n2\n3",
          "explanation": "The loop body starts after 'do'."
        }
      ]
    },
    {
      "id": "scr_done",
      "label": "done",
      "type": "scripting",
      "description": "Marks the end of a loop body for for-, while-, or until-loops.",
      "category": "loop",
      "tags": [
        "loop",
        "end",
        "structure"
      ],
      "examples": [
        {
          "command": "while [ $x -lt 2 ]; do echo $x; x=$((x+1)); done",
          "expected_output": "0\n1",
          "explanation": "The loop ends after 'done'."
        }
      ]
    },
    {
      "id": "scr_case",
      "label": "case",
      "type": "scripting",
      "description": "Performs multi-branch selection based on pattern matching.",
      "category": "control structure",
      "tags": [
        "branch",
        "pattern",
        "match"
      ],
      "examples": [
        {
          "command": "case $x in 1) echo 'One';; 2) echo 'Two';; *) echo 'Other';; esac",
          "expected_output": "One",
          "explanation": "Matches variable x against defined patterns."
        }
      ]
    },
    {
      "id": "scr_function",
