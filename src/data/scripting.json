            "scr_else"
        ]
    },
    {
        "id": "scr_else",
        "label": "else",
        "type": "scripting",
        "description": "Defines the code block to execute when the if-condition is false.",
        "category": "control structure",
        "tags": [
            "conditional",
            "fallback",
            "branch"
        ],
        "examples": [
            {
                "command": "if [ $x -eq 0 ]; then echo 'Zero'; else echo 'Not Zero'; fi",
                "expected_output": "Not Zero",
                "explanation": "The else block executes because the condition is false."
            }
        ],
        "related": [
            "scr_if",
            "scr_then"
        ]
    },
    {
        "id": "scr_do",
        "label": "do",
        "type": "scripting",
        "description": "Marks the beginning of a loop body for for-, while-, or until-loops.",
