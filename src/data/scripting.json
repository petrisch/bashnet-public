    {
        "id": "scr_redirection",
        "label": "Redirection",
        "type": "scripting",
        "description": "Redirects standard output or error to a file or another stream.",
        "category": "io",
        "tags": [
            "stdout",
            "stderr",
            "file",
            "append"
        ],
        "examples": [
            {
                "command": "echo 'Hello' > output.txt",
                "expected_output": "",
                "explanation": "Overwrites output.txt with 'Hello'."
